{
  "name": "typed-regexp",
  "version": "0.1.0",
  "description": "Type-level state machine for mapping RegExp string literals to RegExpExecArray types. Infers capture group tuples and named group objects without build-step macros.",
  "keywords": [
    "capture-groups",
    "regex",
    "regexp",
    "template-literal-types",
    "type-level",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  }
}
